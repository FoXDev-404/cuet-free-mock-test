// CUETFreeMockTest.com — Database Schema (Prisma + SQLite)
// Original schema — no content copied from reference site.
// JSON fields stored as TEXT strings; enums stored as TEXT.

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  attempts   Attempt[]
  bookmarks  Bookmark[]
  reviews    QuestionReview[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  sectionType String   @default("DOMAIN") // LANGUAGE | DOMAIN | GENERAL_TEST
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  chapters   Chapter[]
  tests      Test[]
  questions  Question[]
}

model Chapter {
  id          String   @id @default(cuid())
  name        String
  subjectId   String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)

  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions  Question[]

  @@index([subjectId])
}

model Question {
  id                   String   @id @default(cuid())
  subjectId            String
  chapterId            String?
  type                 String   @default("MCQ")
  stemEn               String
  stemHi               String?
  optionsEn            String   // JSON string: [{id, text}]
  optionsHi            String?  // JSON string: [{id, text}]
  correctAnswer        String
  explanationEn        String?
  explanationHi        String?
  year                 Int?
  source               String   @default("sample")
  difficulty           String   @default("medium")
  marks                Int      @default(5)
  negativeMarks        Int      @default(1)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // English mock test specific fields
  questionNumber        Int?
  passageId             String?
  passageKey            String?
  sourceCorrectOptionOrder Int?
  sourceAnswerLabel     String?
  answerReviewStatus    String   @default("source_key_recorded") // source_key_recorded | needs_manual_review
  dataQualityNote       String?
  sourcePageStart       Int?
  sourcePageEnd         Int?
  sourcePdfFilename     String?

  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter   Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  passage   Passage?  @relation(fields: [passageId], references: [id], onDelete: SetNull)
  attempts  QuestionAttempt[]
  reviews   QuestionReview[]
  bookmarks Bookmark[]
  testLinks TestQuestionLink[]

  @@index([subjectId])
  @@index([chapterId])
  @@index([year])
  @@index([source])
  @@index([passageId])
}

model Test {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  type          String   @default("FULL_LENGTH") // FULL_LENGTH | SUBJECT_WISE | CHAPTER_WISE | PYQ_YEAR_WISE | GENERAL_TEST
  status        String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  subjectId     String?
  year          Int?
  config        String   // JSON string: test config
  totalQuestions Int      @default(0)
  durationMinutes Int     @default(60)
  isPublic      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subject   Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  questions TestQuestionLink[]
  attempts  Attempt[]

  @@index([subjectId])
}

model TestQuestionLink {
  id        String @id @default(cuid())
  testId    String
  questionId String
  order     Int    @default(0)

  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question  Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId])
  @@index([testId])
}

model Attempt {
  id             String   @id @default(cuid())
  userId         String?
  testId         String
  sessionId      String   @unique
  status         String   @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | AUTO_SUBMITTED | ABANDONED
  startedAt      DateTime @default(now())
  submittedAt    DateTime?
  timeSpentSec   Int      @default(0)
  score          Int      @default(0)
  maxScore       Int      @default(0)
  correctCount   Int      @default(0)
  incorrectCount Int      @default(0)
  attemptedCount Int      @default(0)
  percentile     Float?
  configSnapshot String   // JSON string

  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  test     Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers  QuestionAttempt[]

  @@index([userId])
  @@index([testId])
  @@index([sessionId])
  @@index([status])
}

model QuestionAttempt {
  id            String   @id @default(cuid())
  attemptId     String
  questionId    String
  selectedOption String?
  isCorrect     Boolean?
  timeSpentSec  Int      @default(0)
  markedForReview Boolean @default(false)
  cleared       Boolean  @default(false)

  attempt  Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model Bookmark {
  id        String @id @default(cuid())
  userId    String
  questionId String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}

model QuestionReview {
  id        String @id @default(cuid())
  userId    String
  questionId String
  note      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Passage {
  id            String   @id @default(cuid())
  examId        String
  passageKey    String
  title         String
  content       String
  sourcePageStart Int?
  sourcePageEnd   Int?
  createdAt     DateTime @default(now())

  questions Question[]

  @@index([examId])
  @@unique([examId, passageKey])
}

model EnglishMockConfig {
  id            String   @id @default(cuid())
  examId        String   @unique
  durationMinutes Int     @default(60)
  marksCorrect   Int      @default(1)
  marksIncorrect Int      @default(0)
  totalQuestions Int      @default(50)
  isActive       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
