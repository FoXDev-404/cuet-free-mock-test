// CUETFreeMockTest.com — Database Schema (Prisma + SQLite)
// Original schema — no content copied from reference site.
// JSON fields stored as TEXT strings; enums stored as TEXT.

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("USER")
  bio           String?
  isProfilePublic Boolean @default(false)
  mutedUntil    DateTime?
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  attempts   Attempt[]
  bookmarks  Bookmark[]
  reviews    QuestionReview[]
  discussions Discussion[]
  discussionVotes DiscussionVote[]
  discussionReports DiscussionReport[]
  questionReports QuestionReport[]
  badges     UserBadge[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  sectionType String   @default("DOMAIN") // LANGUAGE | DOMAIN | GENERAL_TEST
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  examId      String?
  createdAt   DateTime @default(now())

  exam       Exam?     @relation(fields: [examId], references: [id], onDelete: SetNull)
  chapters   Chapter[]
  tests      Test[]
  questions  Question[]
}

model Chapter {
  id          String   @id @default(cuid())
  name        String
  subjectId   String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)

  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions  Question[]
  topics     Topic[]

  @@index([subjectId])
}

model Topic {
  id          String   @id @default(cuid())
  chapterId   String
  name        String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  chapter   Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([chapterId])
}

model Exam {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String
  category              String   @default("CUET_UG") // CUET_UG | CUET_PG | OTHER
  description           String?
  logoUrl               String?
  coverImageUrl         String?
  syllabusVersion       String?
  instructions          String?
  defaultDurationMinutes Int     @default(60)
  defaultMarksCorrect   Int      @default(5)
  defaultMarksNegative  Int      @default(1)
  status                String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  visibility            String   @default("PUBLIC") // PUBLIC | UNLISTED | PRIVATE
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  years     ExamYear[]
  subjects  Subject[]
  questions Question[]
}

model ExamYear {
  id              String   @id @default(cuid())
  examId          String
  year            Int
  syllabusVersion String?
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, year])
  @@index([examId])
}

model Question {
  id                   String   @id @default(cuid())
  subjectId            String
  chapterId            String?
  topicId              String?
  examId               String?
  externalId           String?
  type                 String   @default("MCQ") // MCQ | MCQ_MULTI | NUMERIC | ASSERTION_REASON | MATCH_FOLLOWING | PASSAGE | FILL_BLANK
  stemEn               String
  stemHi               String?
  richTextEn           String?  // rich HTML/LaTeX body
  optionsEn            String   // JSON string: [{id, text}] (denormalized cache; canonical = QuestionOption)
  optionsHi            String?  // JSON string: [{id, text}]
  correctAnswer        String
  stemHash             String?  // sha-256 of normalized stem+options for content-duplicate detection (imports)
  explanationEn        String?
  explanationHi        String?
  questionImages       String?  // JSON string: [{url, alt}] (stem diagrams)
  explanationImageUrl  String?  // diagram for the worked solution
  explanationImageAlt  String?
  language             String   @default("EN")
  status               String   @default("PUBLISHED") // DRAFT | PENDING_VALIDATION | UNDER_REVIEW | APPROVED | PUBLISHED | ARCHIVED | REJECTED
  year                 Int?
  source               String   @default("sample")
  paperShift           String?
  difficulty           String   @default("medium")
  marks                Int      @default(5)
  negativeMarks        Int      @default(1)
  isActive             Boolean  @default(true)
  version              Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // English mock test specific fields
  questionNumber        Int?
  passageId             String?
  passageKey            String?
  sourceCorrectOptionOrder Int?
  sourceAnswerLabel     String?
  answerReviewStatus    String   @default("source_key_recorded") // source_key_recorded | needs_manual_review
  dataQualityNote       String?
  sourcePageStart       Int?
  sourcePageEnd         Int?
  sourcePdfFilename     String?

  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter   Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  topic     Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  exam      Exam?     @relation(fields: [examId], references: [id], onDelete: SetNull)
  passage   Passage?  @relation(fields: [passageId], references: [id], onDelete: SetNull)
  options   QuestionOption[]
  tags      QuestionTag[]
  versions  QuestionVersion[]
  attempts  QuestionAttempt[]
  reviews   QuestionReview[]
  bookmarks Bookmark[]
  testLinks TestQuestionLink[]
  discussions Discussion[]
  reports   QuestionReport[]

  @@index([subjectId])
  @@index([chapterId])
  @@index([topicId])
  @@index([examId])
  @@index([year])
  @@index([source])
  @@index([passageId])
  @@index([status])
  @@index([stemHash])
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  optionId   String  // stable per-question option key, e.g. "opt-q12-1"
  label      String  // A, B, C, ...
  text       String
  sortOrder  Int
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, optionId])
  @@index([questionId])
}

model QuestionTag {
  id         String @id @default(cuid())
  questionId String
  label      String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, label])
  @@index([label])
}

model QuestionVersion {
  id         String   @id @default(cuid())
  questionId String
  versionNo  Int
  snapshot   String   // full JSON snapshot of the question row at this version
  reason     String?
  actorEmail String?
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, versionNo])
  @@index([questionId])
}

model Test {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  type          String   @default("FULL_LENGTH") // FULL_LENGTH | SUBJECT_WISE | CHAPTER_WISE | PYQ_YEAR_WISE | GENERAL_TEST
  status        String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  subjectId     String?
  examId        String?
  year          Int?
  config        String   // JSON string: test config
  totalQuestions Int      @default(0)
  durationMinutes Int     @default(60)
  isPublic      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subject   Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  questions TestQuestionLink[]
  attempts  Attempt[]
  versions  TestVersion[]
  discussions Discussion[]

  @@index([subjectId])
}

model TestQuestionLink {
  id        String @id @default(cuid())
  testId    String
  questionId String
  order     Int    @default(0)

  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question  Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId])
  @@index([testId])
}

model Attempt {
  id             String   @id @default(cuid())
  userId         String?
  testId         String
  sessionId      String   @unique
  status         String   @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | AUTO_SUBMITTED | ABANDONED
  startedAt      DateTime @default(now())
  deadlineAt     DateTime?
  lastSavedAt    DateTime?
  submittedAt    DateTime?
  timeSpentSec   Int      @default(0)
  score          Int      @default(0)
  maxScore       Int      @default(0)
  correctCount   Int      @default(0)
  incorrectCount Int      @default(0)
  attemptedCount Int      @default(0)
  percentile     Float?
  configSnapshot String   // JSON string
  versionId      String?
  flagged        Boolean @default(false) // suspicious attempt, pending manual review
  flaggedReason  String?
  practice       Boolean @default(false) // practice attempts do not count for leaderboards by default

  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  test     Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  version  TestVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  answers  QuestionAttempt[]
  events   AttemptEvent[]
  reports  QuestionReport[]

  @@index([userId])
  @@index([testId])
  @@index([sessionId])
  @@index([status])
  @@index([deadlineAt])
}

model QuestionAttempt {
  id            String   @id @default(cuid())
  attemptId     String
  questionId    String
  selectedOption String?
  isCorrect     Boolean?
  timeSpentSec  Int      @default(0)
  markedForReview Boolean @default(false)
  cleared       Boolean  @default(false)

  attempt  Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model Bookmark {
  id        String @id @default(cuid())
  userId    String
  questionId String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}

model QuestionReview {
  id        String @id @default(cuid())
  userId    String
  questionId String
  note      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Passage {
  id            String   @id @default(cuid())
  examId        String
  passageKey    String
  title         String
  content       String
  imageUrl      String?
  imageAlt      String?
  sourceNote    String?
  sourcePageStart Int?
  sourcePageEnd   Int?
  createdAt     DateTime @default(now())

  questions Question[]

  @@index([examId])
  @@unique([examId, passageKey])
}

model EnglishMockConfig {
  id            String   @id @default(cuid())
  examId        String   @unique
  durationMinutes Int     @default(60)
  marksCorrect   Int      @default(1)
  marksIncorrect Int      @default(0)
  totalQuestions Int      @default(50)
  isActive       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---- Admin Studio foundation tables ----

model TestVersion {
  id         String   @id @default(cuid())
  testId     String
  versionNo  Int
  snapshot   String   // JSON: config + ordered question ids at publish time
  note       String?
  actorEmail String?
  createdAt  DateTime @default(now())

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  attempts Attempt[]

  @@unique([testId, versionNo])
  @@index([testId])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  actorRole  String?
  action     String   // e.g. QUESTION_UPDATE, TEST_PUBLISH, LEADERBOARD_EXCLUDE
  entityType String   // QUESTION | TEST | SUBJECT | TOPIC | USER | SETTINGS | IMPORT | LEADERBOARD
  entityId   String?
  beforeData String?
  afterData  String?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorEmail])
  @@index([createdAt])
}

model AttemptEvent {
  id        String   @id @default(cuid())
  attemptId String
  type      String   // START | SAVE | RESUME | SUBMIT | AUTO_SUBMIT | EXPIRE
  payload   String?
  createdAt DateTime @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model ImportJob {
  id             String   @id @default(cuid())
  filename       String
  checksum       String?
  source         String   @default("MANUAL") // MANUAL | API | ROLLBACK
  format         String   @default("JSON")   // JSON | CSV | PASTE
  mode           String   @default("COMMIT") // DRY_RUN | COMMIT
  status         String   @default("PENDING") // PENDING | PARSING | VALIDATING | IMPORTING | COMPLETED | FAILED | ROLLED_BACK
  totalRecords   Int      @default(0)
  insertedCount  Int      @default(0)
  updatedCount   Int      @default(0)
  skippedCount   Int      @default(0)
  duplicateCount Int      @default(0)
  failedCount    Int      @default(0)
  errorDetails   String?
  stagedData     String?  // normalized payload for resumable processing
  processedUpTo  Int      @default(0) // resumable pointer
  actorEmail     String?
  createdAt      DateTime @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  updatedAt      DateTime @updatedAt

  errors ImportError[]

  @@index([status])
  @@index([createdAt])
}

model ImportError {
  id        String  @id @default(cuid())
  jobId     String
  rowNumber Int?
  field     String?
  code      String  // MISSING_TEXT | INVALID_TYPE | DUPLICATE_ID | ...
  message   String
  raw       String?

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model LeaderboardConfig {
  id          String   @id @default(cuid())
  name        String
  scope       String   // GLOBAL | EXAM | SUBJECT | TEST | COMPETITION
  periodType  String   @default("ALL_TIME") // ALL_TIME | WEEKLY | MONTHLY
  examId      String?
  subjectId   String?
  testId      String?
  rules       String   @default("{}") // JSON: {bestAttempt, excludePractice, minAttempts, tieBreakers}
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries    LeaderboardEntry[]
  snapshots  LeaderboardSnapshot[]

  @@index([scope])
}

model LeaderboardEntry {
  id             String   @id @default(cuid())
  configId       String
  userId         String
  testId         String?
  bestScore      Float    @default(0)
  maxScore       Float    @default(1)
  percentage     Float    @default(0)
  accuracy       Float    @default(0)
  attemptsCount  Int      @default(0)
  bestTimeSec    Int      @default(0)
  lastSubmittedAt DateTime @default(now())
  rank           Int      @default(0)

  config LeaderboardConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, userId])
  @@index([configId, rank])
}

model LeaderboardSnapshot {
  id         String   @id @default(cuid())
  configId   String
  periodKey  String
  data       String
  createdAt  DateTime @default(now())

  config LeaderboardConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, periodKey])
  @@index([configId, periodKey])
}

model LeaderboardCompetition {
  id          String   @id @default(cuid())
  name        String
  description String?
  examId      String?
  testId      String?
  startsAt    DateTime
  endsAt      DateTime
  rules       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model LeaderboardExclusion {
  id        String   @id @default(cuid())
  userId    String
  attemptId String?
  reason    String
  excludedBy String   // actor email
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---- Blueprint completion: reports, community, editorial, privacy ----

model QuestionReport {
  id             String   @id @default(cuid())
  questionId     String
  userId         String?
  attemptId      String?
  reason         String   // WRONG_ANSWER | TYPO | AMBIGUOUS | MISSING_IMAGE | OTHER
  details        String?
  status         String   @default("OPEN") // OPEN | REVIEWING | RESOLVED | DISMISSED
  resolutionNote String?
  resolvedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  attempt  Attempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([questionId])
  @@index([userId])
}

model Discussion {
  id           String   @id @default(cuid())
  testId       String?
  questionId   String?
  userId       String
  parentId     String?
  body         String
  status       String   @default("VISIBLE") // VISIBLE | PENDING | HIDDEN | DELETED
  isPinned     Boolean  @default(false)
  isBestAnswer Boolean  @default(false)
  upvotes      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  test     Test?      @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question?  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Discussion? @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Discussion[] @relation("DiscussionReplies")
  votes    DiscussionVote[]
  reports  DiscussionReport[]

  @@index([testId, status, createdAt])
  @@index([questionId, status, createdAt])
  @@index([parentId])
  @@index([userId])
}

model DiscussionVote {
  id           String   @id @default(cuid())
  discussionId String
  userId       String
  value        Int      @default(1)
  createdAt    DateTime @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId])
  @@index([userId])
}

model DiscussionReport {
  id           String   @id @default(cuid())
  discussionId String
  userId       String
  reason       String
  details      String?
  status       String   @default("OPEN") // OPEN | REVIEWED | DISMISSED
  createdAt    DateTime @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId])
  @@index([status, createdAt])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, startsAt, endsAt])
}

model PageSeo {
  id           String   @id @default(cuid())
  path         String   @unique
  title        String?
  description  String?
  introContent String?
  faqJson      String?
  updatedBy    String?
  updatedAt    DateTime @updatedAt

  @@index([updatedAt])
}

model ExamInfo {
  id           String    @id @default(cuid())
  key          String    @unique
  label        String
  value        String
  sourceUrl    String?
  lastVerified DateTime?
  updatedBy    String?
  updatedAt    DateTime  @updatedAt

  @@index([key])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeKey  String
  earnedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey])
  @@index([userId])
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

/// Small, audited key/value store for operational feature switches and
/// editorial configuration (registration, community, exam countdown).
model PlatformSetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id         String   @id @default(cuid())
  key        String   @unique
  url        String
  alt        String
  mimeType   String
  width      Int?
  height     Int?
  sizeBytes  Int
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
