{
  "name": "cuet-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "e2e:ci": "start-server-and-test dev http://localhost:3000 test:e2e",
    "cf:wrapper": "opennextjs-cloudflare",
    "cf:d1:create": "wrangler d1 create cuet-mock-db",
    "cf:d1:migrate": "npx prisma migrate deploy --target-d1 cuet-mock-db --local",
    "cf:deploy": "npm run build && npx opennextjs-cloudflare && npx wrangler deploy"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.105.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "next-auth": "^4.24.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.64.1",
    "prisma": "^5.22.0",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "4.155.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261023.1": true
  }
}
